    <!-- ==================== DISEASE DESCRIPTIONS ==================== -->

    <!-- Apple -->
    <string name="desc_apple_scab">Enfermedad fúngica que causa manchas verde oliva a negras en hojas y frutos.</string>
    <string name="desc_apple_black_rot">Enfermedad fúngica que causa podredumbre del fruto, manchas en hojas y cancros en ramas.</string>
    <string name="desc_cedar_apple_rust">Enfermedad fúngica que requiere tanto manzano como cedro/enebro como hospederos.</string>
    <string name="desc_apple_healthy">El manzano parece saludable sin síntomas visibles de enfermedad.</string>

    <!-- Blueberry -->
    <string name="desc_blueberry_healthy">La planta de arándano parece saludable sin síntomas visibles de enfermedad.</string>

    <!-- Cherry -->
    <string name="desc_cherry_powdery_mildew">Enfermedad fúngica que causa recubrimiento blanco polvoriento en hojas y fruto.</string>
    <string name="desc_cherry_healthy">El cerezo parece saludable sin síntomas visibles de enfermedad.</string>

    <!-- Corn -->
    <string name="desc_corn_cercospora_leaf_spot">Enfermedad fúngica que causa lesiones grisáceas con bordes oscuros en las hojas.</string>
    <string name="desc_corn_common_rust">Enfermedad fúngica que causa pústulas rojizo-marrón en las hojas.</string>
    <string name="desc_corn_northern_leaf_blight">Enfermedad fúngica que causa lesiones en forma de cigarro en las hojas.</string>
    <string name="desc_corn_healthy">La planta de maíz parece saludable sin síntomas visibles de enfermedad.</string>

    <!-- Grape -->
    <string name="desc_grape_black_rot">Enfermedad fúngica que causa manchas marrones en hojas y frutos negros arrugados.</string>
    <string name="desc_grape_esca">Complejo fúngico que causa hojas con rayas de tigre y manchas negras en el fruto.</string>
    <string name="desc_grape_leaf_blight">Enfermedad fúngica que causa manchas rojizo-marrón con bordes oscuros.</string>
    <string name="desc_grape_healthy">La vid parece saludable sin síntomas visibles de enfermedad.</string>

    <!-- Orange -->
    <string name="desc_citrus_greening">Enfermedad bacteriana transmitida por psílidos que causa frutos deformes y amargos.</string>

    <!-- Peach -->
    <string name="desc_peach_bacterial_spot">Enfermedad bacteriana que causa manchas oscuras en el fruto y lesiones angulares en hojas.</string>
    <string name="desc_peach_healthy">El durazno parece saludable sin síntomas visibles de enfermedad.</string>

    <!-- Pepper -->
    <string name="desc_pepper_bacterial_spot">Enfermedad bacteriana que causa manchas empapadas que se vuelven marrones con halos amarillos.</string>
    <string name="desc_pepper_healthy">La planta de pimiento parece saludable sin síntomas visibles de enfermedad.</string>

    <!-- Potato -->
    <string name="desc_potato_early_blight">Enfermedad fúngica que causa anillos concéntricos marrones oscuros en las hojas.</string>
    <string name="desc_potato_late_blight">Enfermedad fúngica devastadora que causa lesiones marrones y crecimiento fúngico blanco.</string>
    <string name="desc_potato_healthy">La planta de papa parece saludable sin síntomas visibles de enfermedad.</string>

    <!-- Raspberry -->
    <string name="desc_raspberry_healthy">La planta de frambuesa parece saludable sin síntomas visibles de enfermedad.</string>

    <!-- Soybean -->
    <string name="desc_soybean_healthy">La planta de soja parece saludable sin síntomas visibles de enfermedad.</string>

    <!-- Squash -->
    <string name="desc_squash_powdery_mildew">Enfermedad fúngica que causa recubrimiento blanco polvoriento en las hojas.</string>

