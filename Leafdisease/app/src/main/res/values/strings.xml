    <!-- ==================== TREATMENT STEPS DESCRIPTIONS ==================== -->

    <!-- Apple Scab -->
    <string name="treatment_apple_scab_1_desc">Rake and remove fallen leaves to reduce fungal spores.</string>
    <string name="treatment_apple_scab_2_desc">Use sulfur-based fungicides during early spring.</string>
    <string name="treatment_apple_scab_3_desc">Improve tree ventilation to reduce humidity.</string>

    <!-- Apple Black Rot -->
    <string name="treatment_apple_black_rot_1_desc">Cut branches 4 inches below visible cankers.</string>
    <string name="treatment_apple_black_rot_2_desc">Pick and destroy all infected fruits.</string>
    <string name="treatment_apple_black_rot_3_desc">Use captan or mancozeb-based fungicides.</string>

    <!-- Cedar Apple Rust -->
    <string name="treatment_cedar_apple_rust_1_desc">Remove nearby cedar/juniper trees if possible.</string>
    <string name="treatment_cedar_apple_rust_2_desc">Use myclobutanil or triadimefon sprays.</string>
    <string name="treatment_cedar_apple_rust_3_desc">Consider resistant apple varieties for future.</string>

    <!-- Healthy maintenance -->
    <string name="treatment_continue_maintenance_desc">Maintain regular watering and fertilization schedule.</string>
    <string name="treatment_monitor_regularly_desc">Check leaves periodically for early signs of disease.</string>
    <string name="treatment_prune_as_needed_desc">Remove dead or damaged branches to maintain health.</string>

    <!-- Blueberry -->
    <string name="treatment_blueberry_1_desc">Keep soil pH between 4.5-5.5 for optimal growth.</string>
    <string name="treatment_blueberry_2_desc">Apply 2-3 inches of pine bark mulch.</string>
    <string name="treatment_blueberry_3_desc">Remove canes older than 6 years.</string>

    <!-- Cherry -->
    <string name="treatment_cherry_1_desc">Maintain regular pruning and fertilization.</string>
    <string name="treatment_cherry_2_desc">Check for aphids and other common cherry pests.</string>
    <string name="treatment_cherry_3_desc">Pick fruit when ripe to prevent over-ripening on tree.</string>

    <!-- Corn -->
    <string name="treatment_corn_cercospora_1_desc">Avoid planting corn in the same field for 2+ years.</string>
    <string name="treatment_corn_cercospora_2_desc">Use azoxystrobin or pyraclostrobin if severe.</string>
    <string name="treatment_corn_cercospora_3_desc">Bury crop residue to reduce fungal overwintering.</string>

    <string name="treatment_corn_rust_1_desc">Use rust-resistant corn varieties.</string>
    <string name="treatment_corn_rust_2_desc">Use foliar fungicides if rust is severe.</string>
    <string name="treatment_corn_rust_3_desc">Plant early to avoid peak rust season.</string>

    <string name="treatment_corn_blight_1_desc">Plant hybrids with Ht resistance genes.</string>
    <string name="treatment_corn_blight_2_desc">Rotate with non-host crops for 1-2 years.</string>
    <string name="treatment_corn_blight_3_desc">Apply if lesions appear before tasseling.</string>

    <!-- Grape -->
    <string name="treatment_grape_black_rot_1_desc">Pick and destroy all shriveled berries.</string>
    <string name="treatment_grape_black_rot_2_desc">Cut out diseased canes during dormancy.</string>
    <string name="treatment_grape_black_rot_3_desc">Use mancozeb or myclobutanil sprays.</string>

    <string name="treatment_grape_esca_1_desc">Make pruning cuts only when vines are dry.</string>
    <string name="treatment_grape_esca_2_desc">Apply wound dressing to cuts larger than 1 inch.</string>
    <string name="treatment_grape_esca_3_desc">Eliminate all dead and dying vines.</string>

    <string name="treatment_grape_leaf_blight_1_desc">Use copper-based fungicides in spring.</string>
    <string name="treatment_grape_leaf_blight_2_desc">Prune for better air circulation.</string>
    <string name="treatment_grape_leaf_blight_3_desc">Clear fallen and infected leaves.</string>

    <!-- Citrus Greening -->
    <string name="treatment_citrus_greening_1_desc">Destroy severely infected trees immediately.</string>
    <string name="treatment_citrus_greening_2_desc">Apply insecticides to control Asian citrus psyllid.</string>
    <string name="treatment_citrus_greening_3_desc">Use only certified disease-free nursery stock.</string>

    <!-- Peach -->
    <string name="treatment_peach_1_desc">Prune to maintain open center shape.</string>
    <string name="treatment_peach_2_desc">Remove excess fruit for better size and quality.</string>
    <string name="treatment_peach_3_desc">Apply balanced fertilizer in early spring.</string>

    <!-- Pepper -->
    <string name="treatment_pepper_1_desc">Maintain even soil moisture.</string>
    <string name="treatment_pepper_2_desc">Use phosphorus for fruit development.</string>
    <string name="treatment_pepper_3_desc">Stake tall varieties to prevent breakage.</string>

    <!-- Potato -->
    <string name="treatment_potato_early_blight_1_desc">Use chlorothalonil or mancozeb sprays.</string>
    <string name="treatment_potato_early_blight_2_desc">Avoid planting tomatoes or potatoes for 3+ years.</string>
    <string name="treatment_potato_early_blight_3_desc">Prune lower infected leaves.</string>

    <string name="treatment_potato_late_blight_1_desc">Destroy all infected plants immediately.</string>
    <string name="treatment_potato_late_blight_2_desc">Use mancozeb or chlorothalonil preventively.</string>
    <string name="treatment_potato_late_blight_3_desc">Maintain proper hilling to protect tubers.</string>

    <!-- Raspberry -->
    <string name="treatment_raspberry_1_desc">Remove floricanes after fruiting.</string>
    <string name="treatment_raspberry_2_desc">Use trellis to keep canes upright.</string>
