    <!-- ==================== TREATMENT STEPS DESCRIPTIONS ==================== -->

    <!-- Apple Scab -->
    <string name="treatment_apple_scab_1_desc">Rastrille y elimine las hojas caídas para reducir las esporas fúngicas.</string>
    <string name="treatment_apple_scab_2_desc">Use fungicidas a base de azufre durante la primavera temprana.</string>
    <string name="treatment_apple_scab_3_desc">Mejore la ventilación del árbol para reducir la humedad.</string>

    <!-- Apple Black Rot -->
    <string name="treatment_apple_black_rot_1_desc">Corte las ramas 10 cm debajo de los cancros visibles.</string>
    <string name="treatment_apple_black_rot_2_desc">Recoja y destruya todos los frutos infectados.</string>
    <string name="treatment_apple_black_rot_3_desc">Use fungicidas a base de captan o mancozeb.</string>

    <!-- Cedar Apple Rust -->
    <string name="treatment_cedar_apple_rust_1_desc">Elimine cedros/enebros cercanos si es posible.</string>
    <string name="treatment_cedar_apple_rust_2_desc">Use pulverizaciones de myclobutanil o triadimefon.</string>
    <string name="treatment_cedar_apple_rust_3_desc">Considere variedades de manzano resistentes para el futuro.</string>

    <!-- Healthy maintenance -->
    <string name="treatment_continue_maintenance_desc">Mantenga el programa regular de riego y fertilización.</string>
    <string name="treatment_monitor_regularly_desc">Revise las hojas periódicamente para detectar signos tempranos de enfermedad.</string>
    <string name="treatment_prune_as_needed_desc">Elimine ramas muertas o dañadas para mantener la salud.</string>

    <!-- Blueberry -->
    <string name="treatment_blueberry_1_desc">Mantenga el pH del suelo entre 4.5-5.5 para un crecimiento óptimo.</string>
    <string name="treatment_blueberry_2_desc">Aplique 5-7 cm de mantillo de corteza de pino.</string>
    <string name="treatment_blueberry_3_desc">Elimine los tallos con más de 6 años.</string>

    <!-- Cherry -->
    <string name="treatment_cherry_1_desc">Mantenga la poda y fertilización regulares.</string>
    <string name="treatment_cherry_2_desc">Revise áfidos y otras plagas comunes del cerezo.</string>
    <string name="treatment_cherry_3_desc">Recoja el fruto cuando esté maduro para evitar sobremaduración.</string>

    <!-- Corn -->
    <string name="treatment_corn_cercospora_1_desc">Evite plantar maíz en el mismo campo por más de 2 años.</string>
    <string name="treatment_corn_cercospora_2_desc">Use azoxystrobin o pyraclostrobin si es severo.</string>
    <string name="treatment_corn_cercospora_3_desc">Entierre el residuo de cultivo para reducir el hibernación fúngica.</string>

    <string name="treatment_corn_rust_1_desc">Use variedades de maíz resistentes a la roya.</string>
    <string name="treatment_corn_rust_2_desc">Use fungicidas foliares si la roya es severa.</string>
    <string name="treatment_corn_rust_3_desc">Plante temprano para evitar la temporada pico de roya.</string>

    <string name="treatment_corn_blight_1_desc">Plante híbridos con genes de resistencia Ht.</string>
    <string name="treatment_corn_blight_2_desc">Rote con cultivos no hospederos por 1-2 años.</string>
    <string name="treatment_corn_blight_3_desc">Aplique si aparecen lesiones antes de la espigación.</string>

    <!-- Grape -->
    <string name="treatment_grape_black_rot_1_desc">Recoja y destruya todas las bayas arrugadas.</string>
    <string name="treatment_grape_black_rot_2_desc">Corte los sarmientos enfermos durante la dormancia.</string>
    <string name="treatment_grape_black_rot_3_desc">Use pulverizaciones de mancozeb o myclobutanil.</string>

    <string name="treatment_grape_esca_1_desc">Haga cortes de poda solo cuando las vides estén secas.</string>
    <string name="treatment_grape_esca_2_desc">Aplique cubierta de heridas a cortes mayores a 2.5 cm.</string>
    <string name="treatment_grape_esca_3_desc">Elimine todas las vides muertas y moribundas.</string>

    <string name="treatment_grape_leaf_blight_1_desc">Use fungicidas a base de cobre en primavera.</string>
    <string name="treatment_grape_leaf_blight_2_desc">Pode para mejorar la circulación de aire.</string>
