    <!-- Apple -->
    <string name="desc_apple_scab">Fungal disease causing olive-green to black spots on leaves and fruit.</string>
    <string name="desc_apple_black_rot">Fungal disease causing fruit rot, leaf spots, and cankers on branches.</string>
    <string name="desc_cedar_apple_rust">Fungal disease requiring both apple and cedar/juniper hosts.</string>
    <string name="desc_apple_healthy">Apple tree appears healthy with no visible disease symptoms.</string>

    <!-- Blueberry -->
    <string name="desc_blueberry_healthy">Blueberry plant appears healthy with no visible disease symptoms.</string>

